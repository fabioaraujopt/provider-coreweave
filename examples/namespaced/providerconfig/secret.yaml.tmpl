apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # Keys map 1:1 to the CoreWeave Terraform provider block. Only "token" is
  # required. Create a token in CoreWeave Cloud Console > Access Tokens.
  credentials: |
    {
      "token": "CW-SECRET-replace-me",
      "s3_endpoint": "https://cwobject.com"
    }
